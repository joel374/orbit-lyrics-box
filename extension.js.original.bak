const vscode = require("vscode");
const { exec, execSync } = require("child_process");
const dns = require("dns");

if (dns.setDefaultResultOrder) {
  dns.setDefaultResultOrder("ipv4first");
}

let activeLyricsCache = new Map();
let currentTrackKey = "";
let currentLyrics = [];
let currentSynced = false;
let lastKnownState = null;
let outputChannel = null;

function cleanTrackInfo(rawTitle, rawArtist) {
  let title = rawTitle || "";
  let artist = rawArtist || "";

  if (title.includes(" - ")) {
    const parts = title.split(" - ");
    if (!artist || artist.includes("VEVO") || artist.includes("Topic") || artist.toLowerCase().includes("various")) {
      artist = parts[0].trim();
    }
    title = parts.slice(1).join(" - ").trim();
  }

  title = title.replace(/\s*[\(\[](official\s*(music\s*)?video|lyrics?|official\s*audio|visualizer|remastered?|hd|4k|mv|vorsicht[^\)\]]*)[\)\]]/gi, "").trim();
  title = title.replace(/\s*[\(\[].*?cover.*?[\)\]]/gi, "").trim();
  // Strip common noisy suffixes that break exact matching on LRCLIB
  title = title.replace(/\s*[\(\[][^\)\]]*\b(feat\.?|ft\.?|with|remaster(ed)?|re-?master(ed)?|live|acoustic|version|mono|stereo|edit|radio\s*edit|single\s*version|album\s*version|\d{4}\s*remaster)\b[^\)\]]*[\)\]]/gi, "").trim();
  // Also strip trailing "feat. X" / "ft. X" without brackets
  title = title.replace(/\s*[-–]?\s*\b(feat\.?|ft\.?)\b.*$/i, "").trim();
  title = title.replace(/\s{2,}/g, " ").trim();

  artist = artist.replace(/VEVO$/i, "").replace(/ - Topic$/i, "").trim();

  return { title, artist };
}

// Normalize a string for fuzzy comparison: lowercase, strip accents,
// drop punctuation, unify "&"/"and", collapse whitespace.
function normalizeForMatch(str) {
  return (str || "")
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // strip diacritics
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

// Score how well a search result matches the desired title/artist (0..2).
function scoreCandidate(candidate, title, artist) {
  const wantTitle = normalizeForMatch(title);
  const wantArtist = normalizeForMatch(artist);
  const gotTitle = normalizeForMatch(candidate.trackName || candidate.name);
  const gotArtist = normalizeForMatch(candidate.artistName);

  let score = 0;
  if (gotTitle && (gotTitle === wantTitle || gotTitle.includes(wantTitle) || wantTitle.includes(gotTitle))) {
    score += 1;
  }
  if (wantArtist && gotArtist && (gotArtist === wantArtist || gotArtist.includes(wantArtist) || wantArtist.includes(gotArtist))) {
    score += 1;
  }
  return score;
}

function parseLrc(lrcText) {
  if (!lrcText) return [];
  const lines = lrcText.split("\n");
  const result = [];
  const timeRegex = /\[(\d+):(\d+(?:\.\d+)?)\](.*)/;

  for (const line of lines) {
    const match = line.match(timeRegex);
    if (match) {
      const minutes = parseInt(match[1], 10);
      const seconds = parseFloat(match[2]);
      const text = match[3].trim();
      if (text) {
        result.push({
          time: minutes * 60 + seconds,
          text: text
        });
      }
    }
  }
  return result.sort((a, b) => a.time - b.time);
}

async function fetchLyricsFromLRCLIB(title, artist, duration = 0, album = "") {
  const cacheKey = `${title}____${artist}____${Math.round(duration)}`.toLowerCase();
  if (activeLyricsCache.has(cacheKey)) {
    return activeLyricsCache.get(cacheKey);
  }

  const makeResult = (data) => {
    if (data && data.syncedLyrics) {
      return { lines: parseLrc(data.syncedLyrics), synced: true };
    }
    if (data && data.plainLyrics) {
      const lines = data.plainLyrics
        .split("\n")
        .map(t => t.trim())
        .filter(Boolean)
        .map(text => ({ time: 0, text }));
      return { lines, synced: false };
    }
    return null;
  };

  try {
    // 1) Exact lookup. Sending duration (and album) makes matching far more tolerant.
    const getParams = new URLSearchParams({ track_name: title, artist_name: artist });
    if (album) getParams.set("album_name", album);
    if (duration) getParams.set("duration", String(Math.round(duration)));

    let res = await fetch(`https://lrclib.net/api/get?${getParams.toString()}`, {
      headers: { "User-Agent": "AntigravityLyricsBox/1.0" }
    });
    if (res.ok) {
      const result = makeResult(await res.json());
      if (result && result.lines.length) {
        activeLyricsCache.set(cacheKey, result);
        return result;
      }
    }

    // 2) Search fallback — pick the BEST matching candidate, not just the first synced one.
    const runSearch = async (q) => {
      const r = await fetch(`https://lrclib.net/api/search?q=${encodeURIComponent(q)}`, {
        headers: { "User-Agent": "AntigravityLyricsBox/1.0" }
      });
      return r.ok ? r.json() : [];
    };

    let list = await runSearch(`${title} ${artist}`);
    // If a title+artist query returns nothing, retry with title only.
    if (!Array.isArray(list) || list.length === 0) {
      list = await runSearch(title);
    }

    if (Array.isArray(list) && list.length) {
      // Rank: prefer best title+artist match, then prefer synced lyrics.
      const ranked = list
        .map(c => ({
          c,
          score: scoreCandidate(c, title, artist),
          synced: !!c.syncedLyrics
        }))
        .filter(x => x.score > 0 || list.length === 1)
        .sort((a, b) => (b.score - a.score) || (Number(b.synced) - Number(a.synced)));

      const best = ranked.find(x => x.c.syncedLyrics || x.c.plainLyrics);
      if (best) {
        const result = makeResult(best.c);
        if (result && result.lines.length) {
          activeLyricsCache.set(cacheKey, result);
          return result;
        }
      }
    }
  } catch (err) {
    console.error("[LyricsBox] Fetch error:", err);
  }

  const empty = { lines: [], synced: false };
  activeLyricsCache.set(cacheKey, empty);
  return empty;
}

function getActivePlayer() {
  return new Promise((resolve) => {
    exec("busctl --user list | grep org.mpris.MediaPlayer2", (err, stdout) => {
      if (err || !stdout) return resolve(null);
      const lines = stdout.trim().split("\n").filter(Boolean);
      const players = [];
      for (const line of lines) {
        const match = line.match(/(org\.mpris\.MediaPlayer2\.[^\s]+)/);
        if (match) players.push(match[1]);
      }
      if (players.length === 0) return resolve(null);

      // Check which one is currently playing
      let checked = 0;
      let foundPlaying = null;
      for (const p of players) {
        exec(`busctl --user get-property "${p}" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlaybackStatus`, (e, out) => {
          checked++;
          if (!e && out && out.includes("\"Playing\"")) {
            foundPlaying = p;
          }
          if (checked === players.length) {
            resolve(foundPlaying || players[0]);
          }
        });
      }
    });
  });
}

function getPlayerState(player) {
  return new Promise((resolve) => {
    if (!player) return resolve(null);
    const cmd = `busctl --user get-property "${player}" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlaybackStatus && ` +
                `busctl --user get-property "${player}" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Position && ` +
                `busctl --user get-property "${player}" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Metadata`;

    exec(cmd, (err, stdout) => {
      if (err || !stdout) return resolve(null);

      const statusMatch = stdout.match(/s\s+"([^"]+)"/);
      const status = statusMatch ? statusMatch[1] : "Stopped";

      const posMatch = stdout.match(/x\s+(\d+)/);
      const position = posMatch ? parseInt(posMatch[1], 10) / 1000000 : 0;

      const titleMatch = stdout.match(/"xesam:title"\s+s\s+"([^"]+)"/);
      const rawTitle = titleMatch ? titleMatch[1] : "";

      const artistMatch = stdout.match(/"xesam:artist"\s+as\s+\d+\s+"([^"]+)"/);
      const rawArtist = artistMatch ? artistMatch[1] : "";

      const artMatch = stdout.match(/"mpris:artUrl"\s+s\s+"([^"]+)"/);
      const artUrl = artMatch ? artMatch[1] : "";

      const albumMatch = stdout.match(/"xesam:album"\s+s\s+"([^"]+)"/);
      const album = albumMatch ? albumMatch[1] : "";

      const lenMatch = stdout.match(/"mpris:length"\s+x\s+(\d+)/);
      const duration = lenMatch ? parseInt(lenMatch[1], 10) / 1000000 : 0;

      const cleaned = cleanTrackInfo(rawTitle, rawArtist);

      resolve({
        player,
        playerName: player.split(".").pop(),
        status,
        position,
        rawTitle,
        rawArtist,
        title: cleaned.title || rawTitle || "Unknown Track",
        artist: cleaned.artist || rawArtist || "Unknown Artist",
        artUrl,
        duration: duration || 0,
        album: album || ""
      });
    });
  });
}

function sendPlayerCommand(player, command, arg = "") {
  if (!player) return;
  exec(`busctl --user call "${player}" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player ${command} ${arg}`, (err) => {
    if (err) console.error("[LyricsBox] Command error:", command, err);
  });
}

class LyricsBoxViewProvider {
  constructor(extensionUri) {
    this._extensionUri = extensionUri;
    this._view = null;
  }

  resolveWebviewView(webviewView) {
    this._view = webviewView;
    webviewView.webview.options = {
      enableScripts: true,
      localResourceRoots: [this._extensionUri]
    };

    webviewView.webview.html = this._getHtmlForWebview(webviewView.webview);

    webviewView.webview.onDidReceiveMessage(async (msg) => {
      if (!lastKnownState || !lastKnownState.player) return;
      const player = lastKnownState.player;

      if (msg.type === "playPause") {
        sendPlayerCommand(player, "PlayPause");
      } else if (msg.type === "next") {
        sendPlayerCommand(player, "Next");
      } else if (msg.type === "previous") {
        sendPlayerCommand(player, "Previous");
      } else if (msg.type === "seek") {
        const offsetMicro = Math.round((msg.position - (lastKnownState.position || 0)) * 1000000);
        sendPlayerCommand(player, "Seek", `x ${offsetMicro}`);
      } else if (msg.type === "manualSearch") {
        const result = await fetchLyricsFromLRCLIB(msg.title, msg.artist);
        currentLyrics = result.lines;
        this.postMessage({
          type: "lyricsLoaded",
          lyrics: currentLyrics,
          synced: result.synced,
          title: msg.title,
          artist: msg.artist
        });
      }
    });

    if (lastKnownState) {
      outputChannel.appendLine(`[LyricsBox] Sending initial state to webview: ${lastKnownState.title}`);
      this.postMessage({
        type: "state",
        state: lastKnownState,
        lyrics: currentLyrics,
        synced: currentSynced
      });
    } else {
      outputChannel.appendLine(`[LyricsBox] No initial state yet, will send once polling updates`);
      // Kirim placeholder state biar webview nggak blank
      this.postMessage({
        type: "state",
        state: { title: "Loading...", artist: "", status: "Stopped", position: 0, duration: 0 },
        lyrics: [],
        synced: false
      });
    }
  }

  postMessage(message) {
    if (this._view) {
      this._view.webview.postMessage(message);
    }
  }

  _getHtmlForWebview(webview) {
    return getWebviewContent();
  }
}

function getWebviewContent() {
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src https: http: data: blob: vscode-resource: vscode-webview-resource:; style-src 'unsafe-inline'; script-src 'unsafe-inline';">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lyrics Box</title>
  <style>
    /*
     * MONOCHROME BENTO THEME
     * Colors are derived from the editor theme via --vscode-* variables (3b),
     * so the widget shifts with whatever Antigravity/VS Code theme is active.
     * Everything is monospace, 1px sharp borders, zero rounded corners.
     */
    :root {
      --mono-fg:      var(--vscode-editor-foreground, #e6e6e6);
      --mono-bg:      var(--vscode-editor-background, #0d0d0d);
      --mono-border:  var(--vscode-panel-border, var(--vscode-editorWidget-border, rgba(255,255,255,0.14)));
      --mono-muted:   var(--vscode-disabledForeground, rgba(230,230,230,0.35));
      --mono-faint:   rgba(128,128,128,0.28);
      /* "accent" is just inverse fg/bg for the highlighted lyric block */
      --mono-inv-bg:  var(--vscode-editor-foreground, #e6e6e6);
      --mono-inv-fg:  var(--vscode-editor-background, #0d0d0d);
      --mono-font:    var(--vscode-editor-font-family, var(--vscode-font-family, "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace));
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--mono-font);
    }

    body {
      background: transparent;
      color: var(--mono-fg);
      padding: 6px;
      overflow-x: hidden;
      user-select: none;
      font-size: 11px;
      line-height: 1.4;
    }

    /* The sidebar is a vertical stack of 3 bento boxes. */
    .container {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 12px);
      gap: 6px;
      width: 100%;
    }

    .bento {
      border: 1px solid var(--mono-border);
      background: transparent;
      position: relative;
    }

    /* ===== TOP BENTO: COMPACT PLAYER (kept as short as possible) ===== */
    .player-box {
      display: flex;
      align-items: stretch;
      gap: 0;
      flex-shrink: 0;
    }

    .art-cell {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      border-right: 1px solid var(--mono-border);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: var(--mono-faint);
    }

    /* 36x36 dithered pixel-art look: real art rendered with nearest-neighbor (1a) */
    #albumArt {
      width: 36px;
      height: 36px;
      object-fit: cover;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      filter: grayscale(1) contrast(1.1);
      display: none;
    }

    .art-fallback {
      font-size: 14px;
      color: var(--mono-muted);
    }

    .player-pane {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3px 6px;
      gap: 2px;
    }

    .meta-line {
      display: flex;
      align-items: baseline;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 10px;
    }

    .meta-artist {
      font-weight: 700;
      text-transform: uppercase;
      color: var(--mono-fg);
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .meta-sep { color: var(--mono-muted); }

    .meta-title {
      text-transform: uppercase;
      color: var(--mono-muted);
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .transport-line {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 10px;
      font-size: 10px;
    }

    .ctrl-group { display: flex; align-items: center; gap: 8px; }

    .ctrl-btn {
      background: none;
      border: none;
      color: var(--mono-fg);
      cursor: pointer;
      font-size: 15px;
      line-height: 1;
      padding: 4px 5px;
      opacity: 0.75;
      transition: opacity 0.12s ease, background 0.12s ease;
    }

    .ctrl-btn:hover { opacity: 1; background: var(--mono-faint); }
    .ctrl-btn:active { opacity: 1; }

    .ctrl-play {
      font-weight: 700;
      font-size: 16px;
      border: 1px solid var(--mono-border);
      padding: 3px 8px;
    }
    .ctrl-play:hover { background: var(--mono-faint); }

    /* ASCII progress: 01:42 [==•----] 03:50 */
    .ascii-progress {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 10px;
      color: var(--mono-muted);
      white-space: nowrap;
      cursor: pointer;
    }

    #progressAscii {
      color: var(--mono-fg);
      letter-spacing: 0.5px;
    }

    /* ===== MIDDLE BENTO: LYRICS (takes all remaining height) ===== */
    .lyrics-box {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .lyrics-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 3px 8px;
      border-bottom: 1px solid var(--mono-border);
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--mono-muted);
      flex-shrink: 0;
    }

    .toggle-view-btn {
      background: none;
      border: 1px solid var(--mono-border);
      color: var(--mono-muted);
      font-family: var(--mono-font);
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 1px 6px;
      cursor: pointer;
      transition: color 0.12s ease, border-color 0.12s ease;
    }

    .toggle-view-btn:hover { color: var(--mono-fg); border-color: var(--mono-fg); }

    /* The scrolling lyric column, centered vertically */
    .subtitle-box {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      text-align: center;
      padding: 10px 10px;
      position: relative;
      overflow: hidden;
      gap: 7px;
    }

    /* Gradient fade top & bottom edges */
    .subtitle-box::before,
    .subtitle-box::after {
      content: "";
      position: absolute;
      left: 0; right: 0;
      height: 42px;
      pointer-events: none;
      z-index: 2;
    }
    .subtitle-box::before {
      top: 0;
      background: linear-gradient(to bottom, var(--mono-bg), transparent);
    }
    .subtitle-box::after {
      bottom: 0;
      background: linear-gradient(to top, var(--mono-bg), transparent);
    }

    .lyric-line {
      width: 100%;
      font-family: var(--mono-font);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.2s ease, opacity 0.2s ease;
      cursor: pointer;
    }

    /* previous / upcoming lines: low-contrast faded gray */
    .lyric-prev,
    .lyric-next {
      font-size: 11px;
      color: var(--mono-faint);
      opacity: 0.55;
    }
    .lyric-prev { opacity: 0.4; }

    /* active line: inverse high-contrast block */
    .lyric-active {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--mono-inv-fg);
      background: var(--mono-inv-bg);
      padding: 3px 6px;
      align-self: center;
      max-width: 100%;
      line-height: 1.5;
    }

    .lyric-empty {
      font-size: 11px;
      color: var(--mono-muted);
    }

    /* FULL LYRICS LIST (toggle) */
    .full-lyrics-container {
      display: none;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 8px 10px;
      flex-direction: column;
      gap: 2px;
    }

    .full-lyric-item {
      font-family: var(--mono-font);
      font-size: 11px;
      text-transform: uppercase;
      padding: 2px 4px;
      cursor: pointer;
      color: var(--mono-muted);
      transition: color 0.12s ease, background 0.12s ease;
    }

    .full-lyric-item:hover { color: var(--mono-fg); }

    .full-lyric-item.current {
      color: var(--mono-inv-fg);
      background: var(--mono-inv-bg);
      font-weight: 700;
    }

    /* ===== BOTTOM BENTO: STATUS (very thin) ===== */
    .status-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 3px 8px;
      flex-shrink: 0;
      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--mono-muted);
    }

    .status-link { display: flex; align-items: center; gap: 5px; }

    .status-dot {
      width: 6px;
      height: 6px;
      background: var(--mono-muted);
      flex-shrink: 0;
    }
    .status-dot.playing { background: var(--mono-fg); animation: blink 1.4s steps(1) infinite; }
    .status-dot.paused  { background: var(--mono-muted); }

    @keyframes blink { 50% { opacity: 0.25; } }

    /* pixelated mini visualizer */
    .visualizer {
      display: inline-flex;
      align-items: flex-end;
      gap: 1px;
      height: 9px;
    }
    .visualizer span {
      width: 2px;
      background: var(--mono-fg);
      opacity: 0.7;
      height: 2px;
      animation: vz 0.9s steps(3) infinite alternate;
    }
    .visualizer span:nth-child(2) { animation-delay: 0.1s; }
    .visualizer span:nth-child(3) { animation-delay: 0.3s; }
    .visualizer span:nth-child(4) { animation-delay: 0.15s; }
    .visualizer span:nth-child(5) { animation-delay: 0.4s; }
    .visualizer span:nth-child(6) { animation-delay: 0.25s; }
    .visualizer.paused span { animation-play-state: paused; }

    @keyframes vz { 0% { height: 2px; } 100% { height: 9px; } }

    .status-info { color: var(--mono-faint); }
  </style>
</head>
<body>
  <div class="container">

    <!-- ===== TOP BENTO: COMPACT PLAYER ===== -->
    <div class="bento player-box">
      <div class="art-cell">
        <img id="albumArt" alt="art" />
        <span class="art-fallback" id="artFallback">♪</span>
      </div>
      <div class="player-pane">
        <div class="meta-line">
          <span class="meta-artist" id="trackArtist">—</span>
          <span class="meta-sep">|</span>
          <span class="meta-title" id="trackTitle">NO TRACK</span>
        </div>
        <div class="transport-line">
          <div class="ctrl-group">
            <button class="ctrl-btn" id="prevBtn" title="Previous">⏮</button>
            <button class="ctrl-btn ctrl-play" id="playPauseBtn" title="Play / Pause">⏸</button>
            <button class="ctrl-btn" id="nextBtn" title="Next">⏭</button>
            <button class="ctrl-btn" id="loopBtn" title="Loop" disabled>🔁</button>
          </div>
          <div class="ascii-progress" id="progressTrack" title="Seek">
            <span id="timeCurrent">00:00</span>
            <span id="progressAscii">[------]</span>
            <span id="timeTotal">00:00</span>
          </div>
        </div>
      </div>
    </div>

    <!-- MIDDLE BENTO: LYRICS SYNC -->
    <div class="bento lyrics-box">
      <div class="lyrics-head">
        <span>LYRICS | SYNC</span>
        <button class="toggle-view-btn" id="toggleViewBtn">FULL</button>
      </div>

      <div class="subtitle-box" id="subtitleBox">
        <div class="lyric-line lyric-prev" id="lyricPrev"></div>
        <div class="lyric-line lyric-active" id="lyricActive">WAITING FOR LYRICS</div>
        <div class="lyric-line lyric-next" id="lyricNext"></div>
      </div>

      <div class="full-lyrics-container" id="fullLyricsContainer"></div>
    </div>

    <!-- ===== BOTTOM BENTO: STATUS ===== -->
    <div class="bento status-box">
      <div class="status-link">
        <div class="status-dot playing" id="statusDot"></div>
        <span id="playerSource">IDE_LINK | CONNECTED</span>
      </div>
      <div class="visualizer" id="eqBars">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <span class="status-info" id="statusInfo">IDLE</span>
    </div>

  </div>

  <script>
    const vscode = acquireVsCodeApi();

    let lyrics = [];
    let currentPosition = 0;
    let trackDuration = 0;
    let playbackStatus = "Stopped";
    let lastTickTime = performance.now();
    let currentActiveIndex = -1;
    let showFullLyrics = false;
    let isSynced = true;

    // DOM Elements
    const statusDot = document.getElementById("statusDot");
    const playerSource = document.getElementById("playerSource");
    const albumArt = document.getElementById("albumArt");
    const artFallback = document.getElementById("artFallback");
    const trackTitle = document.getElementById("trackTitle");
    const trackArtist = document.getElementById("trackArtist");
    const timeCurrent = document.getElementById("timeCurrent");
    const timeTotal = document.getElementById("timeTotal");
    const progressAscii = document.getElementById("progressAscii");
    const progressTrack = document.getElementById("progressTrack");
    const lyricPrev = document.getElementById("lyricPrev");
    const lyricActive = document.getElementById("lyricActive");
    const lyricNext = document.getElementById("lyricNext");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const eqBars = document.getElementById("eqBars");
    const statusInfo = document.getElementById("statusInfo");
    const toggleViewBtn = document.getElementById("toggleViewBtn");
    const fullLyricsContainer = document.getElementById("fullLyricsContainer");
    const subtitleBox = document.getElementById("subtitleBox");

    // Build an ASCII progress bar like [==•----]
    function renderAsciiProgress(ratio) {
      const WIDTH = 6;
      const r = Math.max(0, Math.min(1, ratio || 0));
      const head = Math.min(WIDTH - 1, Math.floor(r * WIDTH));
      let bar = "[";
      for (let i = 0; i < WIDTH; i++) {
        if (i < head) bar += "=";
        else if (i === head) bar += "\u2022"; // •
        else bar += "-";
      }
      bar += "]";
      return bar;
    }

    function formatTime(sec) {
      if (!sec || isNaN(sec)) return "0:00";
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ":" + (s < 10 ? "0" : "") + s;
    }

    // Controls listeners
    playPauseBtn.addEventListener("click", () => vscode.postMessage({ type: "playPause" }));
    prevBtn.addEventListener("click", () => vscode.postMessage({ type: "previous" }));
    nextBtn.addEventListener("click", () => vscode.postMessage({ type: "next" }));

    toggleViewBtn.addEventListener("click", () => {
      showFullLyrics = !showFullLyrics;
      if (showFullLyrics) {
        subtitleBox.style.display = "none";
        fullLyricsContainer.style.display = "flex";
        fullLyricsContainer.style.flexDirection = "column";
        toggleViewBtn.innerText = "SYNC";
        renderFullLyricsList();
      } else {
        subtitleBox.style.display = "flex";
        fullLyricsContainer.style.display = "none";
        toggleViewBtn.innerText = "FULL";
      }
    });

    progressTrack.addEventListener("click", (e) => {
      if (!trackDuration) return;
      const rect = progressTrack.getBoundingClientRect();
      const clickRatio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const targetSec = clickRatio * trackDuration;
      vscode.postMessage({ type: "seek", position: targetSec });
    });

    // Handle messages from Extension Host
    window.addEventListener("message", (event) => {
      const msg = event.data;
      console.log("[WebView] Message received:", msg.type);
      if (msg.type === "state") {
        console.log("[WebView] State update:", msg.state?.title);
        if (typeof msg.synced === "boolean") isSynced = msg.synced;
        updateState(msg.state, msg.lyrics);
      } else if (msg.type === "lyricsLoaded") {
        console.log("[WebView] Lyrics loaded:", msg.lyrics?.length);
        lyrics = msg.lyrics || [];
        if (typeof msg.synced === "boolean") isSynced = msg.synced;
        currentActiveIndex = -2; // force re-render
        updateSubtitle(currentPosition);
        if (showFullLyrics) renderFullLyricsList();
      }
    });

    function updateState(state, newLyrics) {
      if (!state) return;
      
      console.log("[WebView] updateState called:", state.title);

      playbackStatus = state.status || "Stopped";
      currentPosition = state.position || 0;
      trackDuration = state.duration || 0;
      lastTickTime = performance.now();

      if (newLyrics) {
        lyrics = newLyrics;
      }

      // Update player meta (artist is primary, title secondary — "ARTIST // TITLE")
      trackTitle.innerText = (state.title || "NO TRACK").toUpperCase();
      trackArtist.innerText = (state.artist || "—").toUpperCase();
      console.log("[WebView] Updated UI: title=" + trackTitle.innerText + ", artist=" + trackArtist.innerText);
      playerSource.innerText = state.status === "Stopped"
        ? "IDE_LINK // IDLE"
        : "IDE_LINK // CONNECTED";
      timeTotal.innerText = formatTime(trackDuration);

      // Album art: real cover rendered pixelated (1a), fallback glyph if none
      if (state.artUrl) {
        albumArt.src = state.artUrl;
        albumArt.style.display = "block";
        artFallback.style.display = "none";
      } else {
        albumArt.style.display = "none";
        albumArt.removeAttribute("src");
        artFallback.style.display = "block";
      }

      // Status Indicator & visualizer
      if (playbackStatus === "Playing") {
        statusDot.className = "status-dot playing";
        eqBars.classList.remove("paused");
        statusInfo.innerText = "PLAYING";
        playPauseBtn.innerText = "⏸";
      } else {
        statusDot.className = "status-dot paused";
        eqBars.classList.add("paused");
        statusInfo.innerText = (playbackStatus || "PAUSED").toUpperCase();
        playPauseBtn.innerText = "▶";
      }

      updateSubtitle(currentPosition);
    }

    function renderFullLyricsList() {
      fullLyricsContainer.innerHTML = "";
      if (!lyrics.length) {
        fullLyricsContainer.innerHTML = "<div class=\"lyric-empty\">NO LYRICS FOUND</div>";
        return;
      }

      lyrics.forEach((item, idx) => {
        const div = document.createElement("div");
        div.className = "full-lyric-item" + (idx === currentActiveIndex ? " current" : "");
        div.innerText = item.text;
        div.addEventListener("click", () => {
          vscode.postMessage({ type: "seek", position: item.time });
        });
        fullLyricsContainer.appendChild(div);
      });
    }

    function updateSubtitle(pos) {
      if (!lyrics || lyrics.length === 0) {
        lyricPrev.innerText = "";
        lyricActive.innerText = playbackStatus === "Playing" ? "LISTENING..." : "PAUSED";
        lyricNext.innerText = "";
        return;
      }

      // Unsynced (plain) lyrics: can't follow playback position.
      // Show a static hint in the subtitle box and surface the full lyrics instead.
      if (!isSynced) {
        if (currentActiveIndex !== -3) {
          currentActiveIndex = -3;
          lyricPrev.innerText = "";
          lyricActive.innerText = "PLAIN LYRICS | NOT SYNCED";
          lyricNext.innerText = "TAP FULL TO READ ALONG";
          if (showFullLyrics) renderFullLyricsList();
        }
        return;
      }

      // Find active line
      let activeIdx = -1;
      for (let i = 0; i < lyrics.length; i++) {
        if (lyrics[i].time <= pos) {
          activeIdx = i;
        } else {
          break;
        }
      }

      if (activeIdx !== currentActiveIndex) {
        currentActiveIndex = activeIdx;

        if (activeIdx === -1) {
          lyricPrev.innerText = "";
          lyricActive.innerText = "• • •";
          lyricNext.innerText = lyrics[0] ? lyrics[0].text : "";
        } else {
          lyricPrev.innerText = activeIdx > 0 ? lyrics[activeIdx - 1].text : "";
          lyricActive.innerText = lyrics[activeIdx].text;
          lyricNext.innerText = (activeIdx + 1 < lyrics.length) ? lyrics[activeIdx + 1].text : "";
        }

        // Auto highlight in full lyrics if open
        if (showFullLyrics) {
          const items = fullLyricsContainer.querySelectorAll(".full-lyric-item");
          items.forEach((el, idx) => {
            if (idx === activeIdx) {
              el.classList.add("current");
              el.scrollIntoView({ behavior: "smooth", block: "center" });
            } else {
              el.classList.remove("current");
            }
          });
        }
      }
    }

    // 60FPS Smooth Clock Loop
    function frameLoop(now) {
      const delta = (now - lastTickTime) / 1000;
      lastTickTime = now;

      if (playbackStatus === "Playing") {
        currentPosition += delta;
        if (trackDuration && currentPosition > trackDuration) {
          currentPosition = trackDuration;
        }

        timeCurrent.innerText = formatTime(currentPosition);

        if (trackDuration > 0) {
          progressAscii.innerText = renderAsciiProgress(currentPosition / trackDuration);
        }

        updateSubtitle(currentPosition);
      }

      requestAnimationFrame(frameLoop);
    }

    requestAnimationFrame(frameLoop);
  </script>
</body>
</html>`;
}

function activate(context) {
  // Create output channel for debugging
  outputChannel = vscode.window.createOutputChannel("Lyrics Box");
  outputChannel.show();
  outputChannel.appendLine("[LyricsBox] Extension activated");
  
  const provider = new LyricsBoxViewProvider(context.extensionUri);

  // Register view for both Explorer and Activity Bar
  context.subscriptions.push(
    vscode.window.registerWebviewViewProvider("lyricsBoxExplorer", provider),
    vscode.window.registerWebviewViewProvider("lyricsBoxSidebar", provider)
  );

  // Register command palette refresh
  context.subscriptions.push(
    vscode.commands.registerCommand("antigravityLyrics.refresh", async () => {
      const player = await getActivePlayer();
      if (player) {
        const state = await getPlayerState(player);
        if (state) {
          const result = await fetchLyricsFromLRCLIB(state.title, state.artist, state.duration, state.album);
          currentLyrics = result.lines;
          currentSynced = result.synced;
          lastKnownState = state;
          provider.postMessage({ type: "state", state, lyrics: currentLyrics, synced: currentSynced });
        }
      }
    })
  );

  // Background polling loop (every 1s)
  let lastCheckedTitle = "";
  outputChannel.appendLine("[LyricsBox] Starting polling loop...");
  
  // Fetch initial state immediately before polling
  (async () => {
    const player = await getActivePlayer();
    if (player) {
      const state = await getPlayerState(player);
      if (state) {
        lastKnownState = state;
        const result = await fetchLyricsFromLRCLIB(state.title, state.artist, state.duration, state.album);
        currentLyrics = result.lines;
        currentSynced = result.synced;
        outputChannel.appendLine(`[LyricsBox] Initial fetch: ${state.title} by ${state.artist}`);
        // Kirim ke webview jika sudah ter-open
        provider.postMessage({
          type: "state",
          state,
          lyrics: currentLyrics,
          synced: currentSynced
        });
      }
    }
  })();
  
  const interval = setInterval(async () => {
    try {
      const player = await getActivePlayer();
      if (!player) {
        outputChannel.appendLine("[LyricsBox] No player found");
        if (lastKnownState && lastKnownState.status !== "Stopped") {
          lastKnownState.status = "Stopped";
          provider.postMessage({ type: "state", state: lastKnownState, lyrics: currentLyrics });
        }
        return;
      }

      outputChannel.appendLine(`[LyricsBox] Player found: ${player}`);
      const state = await getPlayerState(player);
      if (!state) {
        outputChannel.appendLine("[LyricsBox] Could not get player state");
        return;
      }

      outputChannel.appendLine(`[LyricsBox] Track: ${state.title} by ${state.artist}`);
      const trackKey = `${state.title}____${state.artist}`;
      let newLyrics = null;

      if (trackKey !== lastCheckedTitle) {
        lastCheckedTitle = trackKey;
        outputChannel.appendLine(`[LyricsBox] Fetching lyrics for: ${trackKey}`);
        const result = await fetchLyricsFromLRCLIB(state.title, state.artist, state.duration, state.album);
        currentLyrics = result.lines;
        currentSynced = result.synced;
        newLyrics = result.lines;
        outputChannel.appendLine(`[LyricsBox] Got ${result.lines.length} lyric lines (synced: ${result.synced})`);
      }

      lastKnownState = state;
      provider.postMessage({
        type: "state",
        state,
        lyrics: newLyrics || undefined,
        synced: currentSynced
      });
    } catch (e) {
      outputChannel.appendLine(`[LyricsBox] Loop error: ${e.message}`);
    }
  }, 1000);

  context.subscriptions.push({
    dispose: () => clearInterval(interval)
  });
}

function deactivate() {}

module.exports = {
  activate,
  deactivate
};
