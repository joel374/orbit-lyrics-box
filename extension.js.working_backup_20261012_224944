  <script>
    const vscode = acquireVsCodeApi();

    let lyrics = [];
    let currentPosition = 0;
    let trackDuration = 0;
    let playbackStatus = "Stopped";
    let lastTickTime = performance.now();
    let currentActiveIndex = -1;
    let showFullLyrics = false;
    let isSynced = true;
    let receivedState = false;
    let lyricsStatus = "loading"; // loading | found | none | error
    
    console.log("[WebView] Script loaded, waiting for messages...");
    console.log("[WebView] acquireVsCodeApi result:", typeof vscode, vscode ? "OK" : "null");

    // DOM Elements
    const statusDot = document.getElementById("statusDot");
    const playerSource = document.getElementById("playerSource");
    const albumArt = document.getElementById("albumArt");
    const artFallback = document.getElementById("artFallback");
    const trackTitle = document.getElementById("trackTitle");
    const trackArtist = document.getElementById("trackArtist");
    const timeCurrent = document.getElementById("timeCurrent");
    const timeTotal = document.getElementById("timeTotal");
    const progressAscii = document.getElementById("progressAscii");
    const progressTrack = document.getElementById("progressTrack");
    const lyricPrev = document.getElementById("lyricPrev");
    const lyricActive = document.getElementById("lyricActive");
    const lyricNext = document.getElementById("lyricNext");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const eqBars = document.getElementById("eqBars");
    const statusInfo = document.getElementById("statusInfo");
    const toggleViewBtn = document.getElementById("toggleViewBtn");
    const fullLyricsContainer = document.getElementById("fullLyricsContainer");
    const subtitleBox = document.getElementById("subtitleBox");

    // Build an ASCII progress bar like [==•----]
    function renderAsciiProgress(ratio) {
      const WIDTH = 6;
      const r = Math.max(0, Math.min(1, ratio || 0));
      const head = Math.min(WIDTH - 1, Math.floor(r * WIDTH));
      let bar = "[";
      for (let i = 0; i < WIDTH; i++) {
        if (i < head) bar += "=";
        else if (i === head) bar += "\u2022"; // •
        else bar += "-";
      }
      bar += "]";
      return bar;
    }

    function formatTime(sec) {
      if (!sec || isNaN(sec)) return "0:00";
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ":" + (s < 10 ? "0" : "") + s;
    }

    // Controls listeners
    playPauseBtn.addEventListener("click", () => vscode.postMessage({ type: "playPause" }));
    prevBtn.addEventListener("click", () => vscode.postMessage({ type: "previous" }));
    nextBtn.addEventListener("click", () => vscode.postMessage({ type: "next" }));

    toggleViewBtn.addEventListener("click", () => {
      showFullLyrics = !showFullLyrics;
      if (showFullLyrics) {
        subtitleBox.style.display = "none";
        fullLyricsContainer.style.display = "flex";
        fullLyricsContainer.style.flexDirection = "column";
        toggleViewBtn.innerText = "SYNC";
        renderFullLyricsList();
      } else {
        subtitleBox.style.display = "flex";
        fullLyricsContainer.style.display = "none";
        toggleViewBtn.innerText = "FULL";
      }
    });

    progressTrack.addEventListener("click", (e) => {
      if (!trackDuration) return;
      const rect = progressTrack.getBoundingClientRect();
      const clickRatio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const targetSec = clickRatio * trackDuration;
      vscode.postMessage({ type: "seek", position: targetSec });
    });

    // Handle messages from Extension Host
    window.addEventListener("message", (event) => {
      console.log("[WebView] ✓ Message event fired!");
      const msg = event.data;
      console.log("[WebView] Message type:", msg?.type, "data:", msg);
      if (msg.type === "state") {
        receivedState = true;
        console.log("[WebView] ✓ STATE message received!");
        console.log("[WebView] State data:", msg.state);
        if (typeof msg.synced === "boolean") isSynced = msg.synced;
        if (msg.lyricsStatus) lyricsStatus = msg.lyricsStatus;
        updateState(msg.state, msg.lyrics);
      } else if (msg.type === "lyricsLoaded") {
        console.log("[WebView] ✓ LYRICS message received!");
        lyrics = msg.lyrics || [];
        if (typeof msg.synced === "boolean") isSynced = msg.synced;
        if (msg.lyricsStatus) lyricsStatus = msg.lyricsStatus;
        currentActiveIndex = -2; // force re-render
        updateSubtitle(currentPosition);
        if (showFullLyrics) renderFullLyricsList();
      } else {
        console.log("[WebView] ⚠ Unknown message type:", msg?.type);
      }
    });

    function updateState(state, newLyrics) {
      if (!state) return;
      
      console.log("[WebView] updateState called:", state.title);

      playbackStatus = state.status || "Stopped";
      currentPosition = state.position || 0;
      trackDuration = state.duration || 0;
      lastTickTime = performance.now();

      if (newLyrics) {
        lyrics = newLyrics;
        currentActiveIndex = -2; // lyrics were replaced: force the subtitle box to re-render
        if (showFullLyrics) renderFullLyricsList();
      }

      // Update player meta (artist is primary, title secondary — "ARTIST // TITLE")
      trackTitle.innerText = (state.title || "NO TRACK").toUpperCase();
      trackArtist.innerText = (state.artist || "—").toUpperCase();
      console.log("[WebView] Updated UI: title=" + trackTitle.innerText + ", artist=" + trackArtist.innerText);
      playerSource.innerText = state.status === "Stopped"
        ? "IDE_LINK // IDLE"
        : "IDE_LINK // CONNECTED";
      timeTotal.innerText = formatTime(trackDuration);

      // Album art: real cover rendered pixelated (1a), fallback glyph if none
      if (state.artUrl) {
        albumArt.src = state.artUrl;
        albumArt.style.display = "block";
        artFallback.style.display = "none";
      } else {
        albumArt.style.display = "none";
        albumArt.removeAttribute("src");
        artFallback.style.display = "block";
      }

      // Status Indicator & visualizer
      if (playbackStatus === "Playing") {
        statusDot.className = "status-dot playing";
        eqBars.classList.remove("paused");
        statusInfo.innerText = "PLAYING";
        playPauseBtn.innerText = "⏸";
      } else {
        statusDot.className = "status-dot paused";
        eqBars.classList.add("paused");
        statusInfo.innerText = (playbackStatus || "PAUSED").toUpperCase();
        playPauseBtn.innerText = "▶";
      }

      updateSubtitle(currentPosition);
    }

    function renderFullLyricsList() {
      fullLyricsContainer.innerHTML = "";
      if (!lyrics.length) {
        fullLyricsContainer.innerHTML = '<div class="lyric-empty">NO LYRICS FOUND</div>';
        return;
      }

      lyrics.forEach((item, idx) => {
        const div = document.createElement("div");
        div.className = "full-lyric-item" + (idx === currentActiveIndex ? " current" : "");
        div.innerText = item.text;
        div.addEventListener("click", () => {
          vscode.postMessage({ type: "seek", position: item.time });
        });
        fullLyricsContainer.appendChild(div);
      });
    }

    function updateSubtitle(pos) {
      if (!lyrics || lyrics.length === 0) {
        lyricPrev.innerText = "";
        if (lyricsStatus === "none") {
          lyricActive.innerText = "NO LYRICS FOUND";
        } else if (lyricsStatus === "error") {
          lyricActive.innerText = "LYRICS UNAVAILABLE | RETRYING";
        } else if (lyricsStatus === "loading") {
          lyricActive.innerText = "LOADING LYRICS...";
        } else {
          lyricActive.innerText = playbackStatus === "Playing" ? "LISTENING..." : "PAUSED";
        }
        lyricNext.innerText = "";
        return;
      }

      // Unsynced (plain) lyrics: can't follow playback position.
      // Show a static hint in the subtitle box and surface the full lyrics instead.
      if (!isSynced) {
        if (currentActiveIndex !== -3) {
          currentActiveIndex = -3;
          lyricPrev.innerText = "";
          lyricActive.innerText = "PLAIN LYRICS | NOT SYNCED";
          lyricNext.innerText = "TAP FULL TO READ ALONG";
          if (showFullLyrics) renderFullLyricsList();
        }
        return;
      }

      // Find active line
      let activeIdx = -1;
      for (let i = 0; i < lyrics.length; i++) {
        if (lyrics[i].time <= pos) {
          activeIdx = i;
        } else {
          break;
        }
      }

      if (activeIdx !== currentActiveIndex) {
        currentActiveIndex = activeIdx;

        if (activeIdx === -1) {
          lyricPrev.innerText = "";
          lyricActive.innerText = "• • •";
          lyricNext.innerText = lyrics[0] ? lyrics[0].text : "";
        } else {
          lyricPrev.innerText = activeIdx > 0 ? lyrics[activeIdx - 1].text : "";
          lyricActive.innerText = lyrics[activeIdx].text;
          lyricNext.innerText = (activeIdx + 1 < lyrics.length) ? lyrics[activeIdx + 1].text : "";
        }

        // Auto highlight in full lyrics if open
        if (showFullLyrics) {
          const items = fullLyricsContainer.querySelectorAll(".full-lyric-item");
          items.forEach((el, idx) => {
            if (idx === activeIdx) {
              el.classList.add("current");
              el.scrollIntoView({ behavior: "smooth", block: "center" });
            } else {
              el.classList.remove("current");
            }
          });
        }
      }
    }

    // 60FPS Smooth Clock Loop
    function frameLoop(now) {
      const delta = (now - lastTickTime) / 1000;
      lastTickTime = now;

      if (playbackStatus === "Playing") {
        currentPosition += delta;
        if (trackDuration && currentPosition > trackDuration) {
          currentPosition = trackDuration;
        }

        timeCurrent.innerText = formatTime(currentPosition);

        if (trackDuration > 0) {
          progressAscii.innerText = renderAsciiProgress(currentPosition / trackDuration);
        }

        updateSubtitle(currentPosition);
      }

      requestAnimationFrame(frameLoop);
    }

    requestAnimationFrame(frameLoop);

    // FALLBACK: If no message in 1s, show diagnostic
    setTimeout(() => {
      if (!receivedState) {
        console.warn("[WebView] ⚠ No state message received after 1s - extension may not have started");
        trackTitle.innerText = "WAITING...";
        trackArtist.innerText = "No extension data";
      }
    }, 1000);
  </script>
</body>
</html>`;
}

function activate(context) {
  // Create output channel for debugging
  outputChannel = vscode.window.createOutputChannel("Lyrics Box");
  outputChannel.appendLine("[LyricsBox] Extension activated");
  const log = (message) => outputChannel.appendLine(`[LyricsBox] ${message}`);

  let provider = null;
  const controller = new LyricsController({
    fetchLyrics: (lookup, opts) => fetchLyricsFromLRCLIB(lookup, opts),
    onLyrics: (snap) => {
      if (!provider) return;
      provider.postMessage({
        type: "lyricsLoaded",
        lyrics: snap.lyrics,
        synced: snap.synced,
        lyricsStatus: snap.status
      });
    },
    log
  });
  provider = new LyricsBoxViewProvider(context.extensionUri, controller);

  // Register view for both Explorer and Activity Bar
  context.subscriptions.push(
    vscode.window.registerWebviewViewProvider("lyricsBoxExplorer", provider),
    vscode.window.registerWebviewViewProvider("lyricsBoxSidebar", provider)
  );

  const pushState = (state, result) => {
    provider.postMessage({
      type: "state",
      state: toViewState(state),
      // Lyrics are only included when they were reset; async results arrive as "lyricsLoaded"
      lyrics: result.changed ? result.lyrics : undefined,
      synced: result.synced,
      lyricsStatus: result.status
    });
  };

  // Command palette: re-fetch lyrics for the current track, bypassing the cache
  context.subscriptions.push(
    vscode.commands.registerCommand("antigravityLyrics.refresh", async () => {
      const player = await getActivePlayer();
      if (!player) return;
      const state = await getPlayerState(player);
      if (!state) return;
      lastKnownState = state;
      pushState(state, controller.update(state, { force: true }));
    })
  );

  // Background polling (every 1s). Ticks never overlap, and lyrics are fetched in the
  // background so a slow request cannot stall position updates.
  let ticking = false;
  let lastLoggedError = "";

  const tick = async () => {
    if (ticking) return;
    ticking = true;
    try {
      const player = await getActivePlayer();
      if (!player) {
        if (lastKnownState && lastKnownState.status !== "Stopped") {
          lastKnownState.status = "Stopped";
          provider.postMessage({
            type: "state",
            state: toViewState(lastKnownState),
            synced: controller.synced,
            lyricsStatus: controller.status
          });
        }
        return;
      }

      const state = await getPlayerState(player);
      if (!state) {
        if (lastLoggedError !== "state") {
          lastLoggedError = "state";
          log(`Could not get player state for ${player}`);
        }
        return;
      }
      lastLoggedError = "";

      lastKnownState = state;
      pushState(state, controller.update(state));
    } catch (e) {
      log(`Loop error: ${e.message}`);
    } finally {
      ticking = false;
    }
  };

  tick();
  const interval = setInterval(tick, 1000);

  context.subscriptions.push({
    dispose: () => clearInterval(interval)
  });
}

function deactivate() {}

module.exports = {
  activate,
  deactivate,
